# 复制本文件为 .env 并填写。.env 不要提交到 Git。

# ---- 云端大模型（OpenAI 兼容接口）----
# 深度分析需要；不填写则系统仍会采集/评分/生成报告，只是跳过 LLM 深度分析
# 任意 OpenAI 兼容服务商均可（DeepSeek / OpenAI / 通义 / Moonshot / 本地 Ollama 等）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro

# ---- GitHub：可选，建议填写以提高搜索配额（未填则 60 次/小时）----
GITHUB_TOKEN=

# ---- Zotero 自动入库（无需手动 token）：----
# 先在 Zotero「设置 → 高级」勾选「允许其他应用程序与本机 Zotero 通信」，
# 程序运行时会弹授权框，点 Always Allow 即可（授权会缓存到 data/zotero_local_key.json）。

# ---- 邮件推送：可选 ----
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_TO=

# ---- 飞书自定义机器人：可选 ----
FEISHU_WEBHOOK_URL=
